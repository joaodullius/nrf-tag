/*
 * Enable the ADXL367 on the FLPR core instead of the app core. Compare
 * with tag/01-motion-adv/boards/nrf54l15tag_nrf54l15_cpuapp.overlay - same
 * physical sensor, same wiring (int1-gpios/odr unchanged), different owning
 * core. i2c21/adxl367 are disabled on the cpuapp side of this module (see
 * ../../boards/nrf54l15tag_nrf54l15_cpuapp.overlay, Task 2) so only one
 * core ever touches the bus.
 */

/ {
	aliases {
		motion-detector = &adxl367;
	};
};

&i2c21 {
	status = "okay";
};

&adxl367 {
	status = "okay";
	int1-gpios = <&gpio0 3 0>;
	odr = <1>; /* 25 Hz */
};

/*
 * ipc0: icmsg channel to the cpuapp core - mirror of
 * ../../boards/nrf54l15tag_nrf54l15_cpuapp.overlay (tx/rx and VEVIF channel
 * numbers swapped, same physical SRAM regions).
 */
/ {
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		sram_tx: memory@20018000 {
			reg = <0x20018000 0x8000>;
		};

		sram_rx: memory@20020000 {
			reg = <0x20020000 0x8000>;
		};
	};

	ipc {
		ipc0: ipc0 {
			compatible = "zephyr,ipc-icmsg";
			dcache-alignment = <32>;
			tx-region = <&sram_tx>;
			rx-region = <&sram_rx>;
			mboxes = <&cpuflpr_vevif_rx 21>, <&cpuflpr_vevif_tx 20>;
			mbox-names = "rx", "tx";
			status = "okay";
		};
	};
};

&cpuflpr_vevif_rx {
	status = "okay";
};

&cpuflpr_vevif_tx {
	status = "okay";
};
